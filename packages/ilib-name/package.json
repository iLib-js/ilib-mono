{
    "name": "ilib-name",
    "version": "1.0.1",
    "main": "./lib/index.js",
    "module": "./src/index.js",
    "exports": {
        ".": {
            "import": "./src/index.js",
            "require": "./lib/index.js"
        },
        "./assemble.mjs": "./assemble.mjs"
    },
    "description": "Classes to parse and format person names",
    "keywords": [
        "internationalization",
        "i18n",
        "localization",
        "l10n",
        "globalization",
        "g11n",
        "date",
        "time",
        "format",
        "locale",
        "translation",
        "name"
    ],
    "homepage": "https://github.com/iLib-js/ilib-mono/tree/main/packages/ilib-name",
    "bugs": "https://github.com/iLib-js/ilib-mono/issues",
    "email": "marketing@translationcircle.com",
    "license": "Apache-2.0",
    "author": {
        "name": "Edwin Hoogerbeets",
        "web": "http://www.translationcircle.com/",
        "email": "edwin@translationcircle.com"
    },
    "contributors": [
        {
            "name": "Edwin Hoogerbeets",
            "email": "ehoogerbeets@gmail.com"
        },
        {
            "name": "Goun Lee",
            "email": "goun.lee@lge.com"
        }
    ],
    "files": [
        "assemble.mjs",
        "src",
        "locale",
        "lib",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/iLib-js/ilib-mono"
    },
    "engines": {
        "node": ">=12 <23"
    },
    "scripts": {
        "build": "pnpm build:prod",
        "build:prod": "grunt babel --mode=prod && pnpm build:pkg",
        "build:dev": "grunt babel --mode=dev && pnpm build:pkg",
        "build:pkg": "echo '{\"type\": \"commonjs\"}' > lib/package.json",
        "build:locales": "echo '{\"locales\":[' $(cat locales.txt) ']}' > locales.json",
        "build:assemble": "pnpm build:locales && ilib-assemble -m . --resources ./locale --localefile ./locales.json assembled src",
        "test": "pnpm test:jest",
        "test:cli": "LANG=en_US.UTF8 node --experimental-vm-modules node_modules/jest/bin/jest.js --testEnvironment node",
        "test:jest": "npm-run-all --npm-path pnpm build:assemble test:cli",
        "test:watch": "LANG=en_US.UTF8 node --experimental-vm-modules node_modules/jest/bin/jest.js --testEnvironment node --watch",
        "coverage": "pnpm test:cli --coverage",
        "test:karma": "LANG=en_US.UTF8 NODE_OPTIONS=\"$NODE_OPTIONS\" node --experimental-vm-modules node_modules/karma/bin/karma start karma.conf.js --reporters dots",
        "test:web": "pnpm build:assemble && pnpm test:karma --single-run",
        "test:all": "npm-run-all --npm-path pnpm test:cli test:web",
        "debug": "npm-run-all --npm-path pnpm build:assemble ; node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --testEnvironment node -i",
        "debug:web": "pnpm build:assemble && pnpm test:karma",
        "clean": "git clean -f -d src test && rm -rf lib assembled test-web *.tgz locales.json",
        "doc": "mkdir -p docs && jsdoc2md -c jsdoc.json --separators --source src/* -m table > docs/ilibName.md && pnpm doc:html",
        "doc:html": "jsdoc -c jsdoc.json"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/plugin-transform-regenerator": "^8.0.2",
        "@babel/preset-env": "^8.0.2",
        "@babel/register": "^8.0.1",
        "@babel/runtime": "^8.0.0",
        "@open-wc/webpack-import-meta-loader": "^0.4.7",
        "babel-loader": "^10.1.1",
        "babel-plugin-add-module-exports": "^1.0.4",
        "babel-plugin-module-resolver": "^5.0.3",
        "babel-plugin-transform-import-meta": "^3.0.0",
        "docdash": "^2.0.2",
        "grunt": "^1.6.3",
        "grunt-babel": "^8.0.0",
        "grunt-cli": "^1.5.0",
        "grunt-contrib-clean": "^2.0.1",
        "grunt-contrib-uglify": "^5.2.2",
        "ilib-assemble": "workspace:^",
        "ilib-internal": "workspace:^",
        "jest": "^30.5.1",
        "jsdoc": "^4.0.5",
        "jsdoc-to-markdown": "^9.1.3",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-firefox-launcher": "^2.1.3",
        "karma-jasmine": "^5.1.0",
        "karma-webpack": "^5.0.1",
        "load-grunt-tasks": "^5.1.0",
        "npm-run-all": "^4.1.5",
        "webpack": "^5.110.3",
        "webpack-cli": "^7.2.3"
    },
    "dependencies": {
        "ilib-common": "workspace:^",
        "ilib-ctype": "workspace:^",
        "ilib-env": "workspace:^",
        "ilib-istring": "workspace:^",
        "ilib-locale": "workspace:^",
        "ilib-localedata": "workspace:^",
        "json5": "^2.2.3"
    }
}