{
    "name": "loctool3",
    "version": "3.0.0",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "bin": {
        "loctool": "./lib/cli.js"
    },
    "description": "A string resource extractor for multiple file types and project types",
    "keywords": [
        "internationalization",
        "i18n",
        "localization",
        "l10n",
        "globalization",
        "g11n",
        "strings",
        "resources",
        "locale",
        "translation"
    ],
    "homepage": "https://github.com/iLib-js/ilib-mono/blob/main/packages/loctool3",
    "bugs": "https://github.com/iLib-js/ilib-mono/issues",
    "email": "marketing@translationcircle.com",
    "license": "Apache-2.0",
    "author": {
        "name": "Edwin Hoogerbeets",
        "web": "http://www.translationcircle.com/",
        "email": "edwin@translationcircle.com"
    },
    "contributors": [
        {
            "name": "Edwin Hoogerbeets",
            "email": "ehoogerbeets@gmail.com"
        },
        {
            "name": "Goun Lee",
            "email": "goun.lee@lge.com"
        }
    ],
    "files": [
        "lib",
        "src",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/iLib-js/ilib-mono"
    },
    "engines": {
        "node": ">=12 <23"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "coverage": "pnpm test --coverage",
        "types": "tsc",
        "test": "LANG=en_US.UTF8 node node_modules/jest/bin/jest.js --testEnvironment node",
        "test:watch": "pnpm test --watch",
        "debug": "node --inspect-brk node_modules/jest/bin/jest.js --testEnvironment node --runInBand",
        "clean": "rm -rf lib coverage",
        "doc": "mkdir -p docs && npm-run-all --npm-path pnpm doc:html doc:md",
        "doc:md": "mkdir -p docs && typedoc --entryFileName index --plugin typedoc-plugin-markdown --skipErrorChecking --cleanOutputDir false --readme none --out docs src/index.ts",
        "doc:html": "mkdir -p docs && typedoc --out docs --skipErrorChecking --cleanOutputDir false src/index.ts"
    },
    "devDependencies": {
        "@tsconfig/node12": "^12.1.4",
        "@types/jest": "^29.5.14",
        "@types/node": "12",
        "docdash": "^2.0.2",
        "ilib-internal": "workspace:^",
        "jest": "^29.7.0",
        "npm-run-all": "^4.1.5",
        "ts-jest": "^29.2.5",
        "typedoc": "^0.26.11",
        "typedoc-plugin-markdown": "^4.2.10",
        "typescript": "^5.9.2"
    }
}
